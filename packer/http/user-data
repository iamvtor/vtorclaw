#cloud-config
chpasswd:
  expire: false

autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  storage:
    layout:
      name: direct
  packages:
    - linux-tools-virtual
    - linux-cloud-tools-virtual
    - openssh-client
  network:
    version: 2
    ethernets:
      eth0:
        dhcp4: true
        optional: true
  identity:
    hostname: openclaw-golden
    username: ubuntu
    password: "$6$VKeUXi/iUw7gj5/C$Ok5ZA.fjMcZFG/GAkDz9LWUWvCi9Gdo4KlKINAkC//zhB3yOOPrk4Ws8iFjozEa7WE2QBpuTtPy6ugsWnTUh01"
  ssh:
    install-server: true
    allow-pw: true
  late-commands:
    # Ensure openssh-server (and thus sshd_config) is definitely installed before we edit its config
    - "chroot /target apt-get install -y --no-install-recommends openssh-server || true"
    - "test -f /target/etc/ssh/sshd_config && sed -i 's/^#*PasswordAuthentication .*/PasswordAuthentication no/' /target/etc/ssh/sshd_config || true"
    - "test -f /target/etc/ssh/sshd_config && sed -i 's/^#*PermitRootLogin .*/PermitRootLogin no/' /target/etc/ssh/sshd_config || true"
    - "test -f /target/etc/ssh/sshd_config && echo 'PermitUserEnvironment yes' >> /target/etc/ssh/sshd_config || true"
    # No Subsystem sftp so Packer falls back to scp for uploads (scp binary provided by openssh-client package)
    - "chroot /target mkdir -p /home/ubuntu && chroot /target chown ubuntu:ubuntu /home/ubuntu && chroot /target chmod 755 /home/ubuntu || true"
    # Install the build host's SSH public key for key-based auth (PasswordAuthentication is disabled).
    # >>> REPLACE THE LINE BELOW WITH YOUR REAL PUBLIC KEY BEFORE BUILDING <<<
    # Generate one with: ssh-keygen -t ed25519 -f ~/.ssh/packer_build_key
    # Then copy the entire public key line (starts with ssh-ed25519 or ssh-rsa) and replace below.
    # After editing, load the private key into your agent before packer build:
    #   - OpenSSH: Start-Service ssh-agent; ssh-add ~/.ssh/packer_build_key
    #   - Or use PuTTY Pageant.
    - "chroot /target mkdir -p /home/ubuntu/.ssh"
    - "echo 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI___REPLACE_ME_WITH_YOUR_ACTUAL_PUBLIC_KEY___ packer-build' > /target/home/ubuntu/.ssh/authorized_keys"
    - "chroot /target chown -R ubuntu:ubuntu /home/ubuntu/.ssh"
    - "chroot /target chmod 700 /home/ubuntu/.ssh"
    - "chroot /target chmod 600 /home/ubuntu/.ssh/authorized_keys"
    - "echo 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin' > /target/home/ubuntu/.ssh/environment"
    - "chroot /target chown ubuntu:ubuntu /home/ubuntu/.ssh/environment"
    - "chroot /target chmod 600 /home/ubuntu/.ssh/environment"
    - "echo 'AllowUsers ubuntu' >> /target/etc/ssh/sshd_config"
    - "echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ubuntu"
    - "chmod 440 /target/etc/sudoers.d/ubuntu"
    - "chroot /target systemctl enable --now ssh || true"
    - "echo 'ubuntu:$6$VKeUXi/iUw7gj5/C$Ok5ZA.fjMcZFG/GAkDz9LWUWvCi9Gdo4KlKINAkC//zhB3yOOPrk4Ws8iFjozEa7WE2QBpuTtPy6ugsWnTUh01' | chpasswd -e -R /target || true"
    - "chroot /target chage -d 0 -m 0 -M 99999 -I -1 ubuntu || true"
    - "chroot /target passwd -u ubuntu || true"
    - "chroot /target ufw allow 22/tcp || true"
    - "chroot /target ufw --force disable || true"
    - "chroot /target systemctl restart ssh || true"
    - "chmod 1777 /target/tmp || true"
    # Ensure scp (used by Packer for script uploads when no sftp subsystem) is found in PATH for the ubuntu user during non-interactive sessions
    - "echo 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin' >> /target/etc/environment || true"
    - "echo 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin' >> /target/home/ubuntu/.profile || true"
    - "chroot /target chown ubuntu:ubuntu /home/ubuntu/.profile || true"
    # Markers so you see on the console when autoinstall/late-commands are done
    - "echo '=== LATE-COMMANDS COMPLETE (autoinstall done) ===' | tee /target/etc/motd.d/late-commands-done /dev/ttyS0 /dev/tty0 2>/dev/null || true"
    - "echo 'cloud-init is now finished. Packer will take over via SSH for the rest of the build.' | tee -a /target/etc/motd.d/late-commands-done /dev/ttyS0 /dev/tty0 2>/dev/null || true"

# ==========================================
# 1. CRITICAL: SECURITY & SECRETS
# ==========================================
# NEVER commit your credentials, private tokens, or network handshakes
.env
.env.local
.env.*.local
*.pem
*.key
*.pub
id_rsa
id_ed25519

# ==========================================
# 2. RUNTIME STAGING & TRANSIENTS
# ==========================================
# Blocks the temporary host memory templates generated by deploy.ps1
*tmp*
*.tmp
*.log
nohup.out

# ==========================================
# 3. WINDOWS SYSTEM STACK
# ==========================================
# Host OS artifacts generated by file exploration
Thumbs.db
Ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# 4. INFRASTRUCTURE & VM ARTIFACTS (OPTIONAL)
# ==========================================
# Prevents any local testing virtual state data logs from cluttering the repo
.multipass/
*.vhdx
*.vdi
*.vmdk

